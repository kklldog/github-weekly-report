[Unit]
Description=Generate GitHub Weekly Top 1 WeChat tie-tu preview
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/home/kklldog/github-weekly
EnvironmentFile=/home/kklldog/github-weekly/app.env
ExecStart=/home/kklldog/github-weekly/.venv/bin/python /home/kklldog/github-weekly/weekly_pipeline.py run
Restart=on-failure
RestartSec=1h
