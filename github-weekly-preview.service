[Unit]
Description=GitHub Weekly Top 1 WeChat tie-tu preview and confirmation watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/kklldog/github-weekly
EnvironmentFile=/home/kklldog/github-weekly/app.env
ExecStart=/home/kklldog/github-weekly/.venv/bin/python /home/kklldog/github-weekly/weekly_pipeline.py watch
Restart=always
RestartSec=20
KillMode=control-group
TimeoutStopSec=15
SendSIGKILL=yes

[Install]
WantedBy=default.target
